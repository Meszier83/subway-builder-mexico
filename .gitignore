*.csv
*.xlsx
*.xls
*.pbf
*.osm.pbf
*.pmtiles
*.geojson
*.bin.gz
*.json.gz
*.zip
demand_data.json
config.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
.env/
.env
