*.csv
*.xlsx
*.osm.pbf
*.pmtiles
*.geojson
*.bin.gz
*.json.gz
*.zip
demand_data.json
config.json

# Python
__pycache__/
*.pyc
.pytest_cache/
venv/
.env/

# Build temporales y datos locales
build/
dist/
data/
